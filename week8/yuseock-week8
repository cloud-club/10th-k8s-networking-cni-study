  <div class="progress" id="progress"></div>
  <span class="counter" id="counter" aria-live="polite"></span>
  <div class="controls">
    <button id="prev" type="button" aria-label="이전 슬라이드">← 이전</button>
    <button id="next" type="button" aria-label="다음 슬라이드">다음 →</button>
    <button id="notes" type="button" class="optional" aria-pressed="false">메모 N</button>
    <button id="fullscreen" type="button" class="optional">전체화면 F</button>
    <button id="print" type="button" class="optional">인쇄 / PDF</button>
  </div>
