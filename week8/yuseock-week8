<script>
(() => {
  "use strict";
  const slides = Array.from(document.querySelectorAll(".slide"));
  const counter = document.getElementById("counter");
  const progress = document.getElementById("progress");
  const prev = document.getElementById("prev");
  const next = document.getElementById("next");
  const notes = document.getElementById("notes");
  let index = 0;

  function fromHash() {
    const match = location.hash.match(/^#slide-(\d+)$/);
    return match ? Number(match[1]) - 1 : 0;
  }

  function show(value, updateHash = true) {
    index = Math.max(0, Math.min(slides.length - 1, value));

    slides.forEach((slide, i) => {
      const active = i === index;
      slide.classList.toggle("active", active);
      slide.hidden = !active;
    });

    counter.textContent =
      String(index + 1).padStart(2, "0") + " / " + slides.length;
    progress.style.width = ((index + 1) / slides.length * 100) + "%";
    prev.disabled = index === 0;
    next.disabled = index === slides.length - 1;

    if (updateHash) {
      try {
        history.replaceState(null, "", "#slide-" + (index + 1));
      } catch (_) {
        // 슬라이드 이동은 주소 변경이 불가능한 환경에서도 동작합니다.
      }
    }
    window.scrollTo({ top: 0, behavior: "instant" });
  }

  function toggleNotes() {
    const enabled = document.body.classList.toggle("show-notes");
    notes.setAttribute("aria-pressed", String(enabled));
  }

  async function toggleFullscreen() {
    try {
      if (document.fullscreenElement) {
        await document.exitFullscreen();
      } else if (document.documentElement.requestFullscreen) {
        await document.documentElement.requestFullscreen();
      } else {
        alert("이 브라우저에서는 브라우저 메뉴의 전체화면 기능을 사용해주세요.");
      }
    } catch (_) {
      alert("전체화면을 사용할 수 없습니다. 브라우저 메뉴에서 실행해주세요.");
    }
  }

  prev.addEventListener("click", () => show(index - 1));
  next.addEventListener("click", () => show(index + 1));
  notes.addEventListener("click", toggleNotes);
  document.getElementById("fullscreen")
    .addEventListener("click", toggleFullscreen);
  document.getElementById("print")
    .addEventListener("click", () => window.print());

  document.addEventListener("keydown", event => {
    if (event.altKey || event.ctrlKey || event.metaKey) return;
    if (event.target.closest(
      "button, a, input, textarea, select, [contenteditable='true']"
    )) return;

    switch (event.key) {
      case "ArrowRight":
      case "PageDown":
      case " ":
        event.preventDefault();
        show(index + (event.shiftKey ? -1 : 1));
        break;
      case "ArrowLeft":
      case "PageUp":
        event.preventDefault();
        show(index - 1);
        break;
      case "Home":
        event.preventDefault();
        show(0);
        break;
      case "End":
        event.preventDefault();
        show(slides.length - 1);
        break;
      case "n":
      case "N":
        toggleNotes();
        break;
      case "f":
      case "F":
        toggleFullscreen();
        break;
    }
  });

  window.addEventListener("hashchange", () => show(fromHash(), false));

  // 인쇄 시 hidden 속성을 제거해 모든 슬라이드를 출력합니다.
  window.addEventListener("beforeprint", () => {
    slides.forEach(slide => { slide.hidden = false; });
  });
  window.addEventListener("afterprint", () => show(index, false));

  show(fromHash(), false);
})();
</script>
